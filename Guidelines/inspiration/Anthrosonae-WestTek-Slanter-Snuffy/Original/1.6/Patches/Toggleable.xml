<?xml version="1.0" encoding="utf-8" ?>
<Patch>

	<!-- Inheritability -->
	<Operation Class="VEF.PatchOperationToggableSequence">
		<enabled>false</enabled>
		<label>Enable inheritability:</label>
		<operations>
			<li Class="PatchOperationAdd">
				<xpath>Defs/XenotypeDef[@Name="ATK_AnthrosonaBase"]</xpath>
				<value><inheritable>true</inheritable></value>
			</li>

			<li Class="PatchOperationAdd">
				<xpath>Defs/XenotypeDef[defName="Sanguophage"]/doubleXenotypeChances</xpath>
				<value>
					<ATK_Anthrobear>0.002</ATK_Anthrobear>
					<ATK_Anthrocat>0.002</ATK_Anthrocat>
					<ATK_Anthrocow>0.002</ATK_Anthrocow>
					<ATK_Anthrodeer>0.002</ATK_Anthrodeer>
					<ATK_Anthrodrake>0.002</ATK_Anthrodrake>
					<ATK_Anthrofox>0.002</ATK_Anthrofox>
					<ATK_Anthrogoat>0.002</ATK_Anthrogoat>
					<ATK_Anthrogriff>0.002</ATK_Anthrogriff>
					<ATK_Anthrohorse>0.002</ATK_Anthrohorse>
					<ATK_Anthrohyena>0.002</ATK_Anthrohyena>
					<ATK_Anthropanda>0.002</ATK_Anthropanda>
					<ATK_Anthrorabbit>0.002</ATK_Anthrorabbit>
					<ATK_Anthroshark>0.002</ATK_Anthroshark>
					<ATK_Anthrowah>0.002</ATK_Anthrowah>
					<ATK_Anthrowolf>0.002</ATK_Anthrowolf>
				</value>
			</li>
		</operations>
	</Operation>


	<!-- Unnatural fur colors -->
	<Operation Class="VEF.PatchOperationToggableSequence">
		<enabled>true</enabled>
		<label>Enable unnatural fur colors:</label>
		<operations>
			<li Class="PatchOperationAdd">
				<xpath>Defs/GeneDef[defName="ATK_AnthrobearFur" or defName="ATK_AnthrocatFur" or defName="ATK_AnthrocowFur" or defName="ATK_AnthrodeerFur" or defName="ATK_AnthrofoxFur" or defName="ATK_AnthrogriffFur" or defName="ATK_AnthrogoatFur" or defName="ATK_AnthrorabbitFur" or defName="ATK_AnthrosharkFur" or defName="ATK_AnthrowolfFur"]/modExtensions/li[@Class="Anthrosonae.FurColors"]/allowedFurColors</xpath>
				<value>
                    <li>ATK_FurPreset_PaleBlueWhite</li>
                    <li>ATK_FurPreset_DeepBlueWhite</li>
                    <li>ATK_FurPreset_PurpleWhite</li>
                    <li>ATK_FurPreset_DeepRedWhite</li>
                    <li>ATK_FurPreset_DeepRedCream</li>
                    <li>ATK_FurPreset_YellowWhite</li>
                    <li>ATK_FurPreset_PaleGreenWhite</li>
                    <li>ATK_FurPreset_DeepGreenWhite</li>
                    <li>ATK_FurPreset_PinkWhite</li>
				</value>
			</li>

			<li Class="PatchOperationAdd">
				<xpath>Defs/GeneDef[defName="ATK_AnthrohyenaFur"]/modExtensions/li[@Class="Anthrosonae.FurColors"]/allowedFurColors</xpath>
				<value>
                    <li>ATK_FurPreset_GrayDarkGray</li>
                    <li>ATK_FurPreset_GrayLightWhite</li>
                    <li>ATK_FurPreset_White</li>
					
                    <li>ATK_FurPreset_PaleBlueWhite</li>
                    <li>ATK_FurPreset_DeepBlueWhite</li>
                    <li>ATK_FurPreset_PurpleWhite</li>
                    <li>ATK_FurPreset_DeepRedWhite</li>
                    <li>ATK_FurPreset_DeepRedCream</li>
                    <li>ATK_FurPreset_YellowWhite</li>
                    <li>ATK_FurPreset_PaleGreenWhite</li>
                    <li>ATK_FurPreset_DeepGreenWhite</li>
                    <li>ATK_FurPreset_PinkWhite</li>
				</value>
			</li>

			<li Class="PatchOperationAdd">
				<xpath>Defs/GeneDef[defName="ATK_AnthrowahFur"]/modExtensions/li[@Class="Anthrosonae.FurColors"]/allowedFurColors</xpath>
				<value>
                    <li>ATK_FurPreset_GrayBlack</li>

                    <li>ATK_FurPreset_PaleBlueBlack</li>
                    <li>ATK_FurPreset_DeepBlueBlack</li>
                    <li>ATK_FurPreset_PurpleBlack</li>
                    <li>ATK_FurPreset_DeepRedBlack</li>
                    <li>ATK_FurPreset_DeepRedCream</li>
                    <li>ATK_FurPreset_YellowBlack</li>
                    <li>ATK_FurPreset_PaleGreenBlack</li>
                    <li>ATK_FurPreset_DeepGreenBlack</li>
                    <li>ATK_FurPreset_PinkBlack</li>
				</value>
			</li>
		</operations>
	</Operation>

	<!-- Genepack generation
	// Contributed by bit_synergy on Discord
	-->
	<Operation Class="VEF.PatchOperationToggableSequence">
		<enabled>false</enabled>
		<label>Enable anthrosonae genes generating in genepacks:</label>
		<operations>
			<li Class="PatchOperationReplace">
			<xpath>Defs/GeneDef[@Name="ATK_AnthrosonaFurBase" or @Name="ATK_AnthrosonaHeadboneBase" or @Name="ATK_AnthrosonaEarsBase" or @Name="ATK_AnthrosonaTailBase" or @Name="ATK_AnthrosonaBackboneBase" or @Name="ATK_AnthrosonaFacialOverlayBase"]/canGenerateInGeneSet</xpath>
				<value><canGenerateInGeneSet>true</canGenerateInGeneSet></value>
			</li>
		</operations>
	</Operation>



<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Temporary full-silhouette Skinwalker art. A FurDef replaces the naked body
    graphic without inventing a new body type, so vanilla apparel can continue
    to use its normal Male/Female/Hulk/Fat/Thin graphics. The opaque raccoon art
    covers the human body; the transparent head removes the remaining human head.
  -->
  <FurDef>
    <defName>WestTek_SkinwalkerRaccoon</defName>
    <noGraphic>true</noGraphic>
    <bodyTypeGraphicPaths>
      <Male>Things/Pawn/Humanlike/Bodies/WestTek/Skinwalker/WestTek_Skinwalker</Male>
      <Female>Things/Pawn/Humanlike/Bodies/WestTek/Skinwalker/WestTek_Skinwalker</Female>
      <Hulk>Things/Pawn/Humanlike/Bodies/WestTek/Skinwalker/WestTek_Skinwalker</Hulk>
      <Fat>Things/Pawn/Humanlike/Bodies/WestTek/Skinwalker/WestTek_Skinwalker</Fat>
      <Thin>Things/Pawn/Humanlike/Bodies/WestTek/Skinwalker/WestTek_Skinwalker</Thin>
      <Child>Things/Pawn/Humanlike/Bodies/WestTek/Skinwalker/WestTek_Skinwalker</Child>
      <Baby>Things/Pawn/Humanlike/Bodies/WestTek/Skinwalker/WestTek_Skinwalker</Baby>
    </bodyTypeGraphicPaths>
  </FurDef>

  <HeadTypeDef>
    <defName>WestTek_Skinwalker_InvisibleHead</defName>
    <graphicPath>Things/Pawn/Humanlike/Heads/WestTek/Skinwalker/WestTek_Skinwalker_InvisibleHead</graphicPath>
    <gender>None</gender>
    <hairMeshSize>(0, 0)</hairMeshSize>
    <beardMeshSize>(0, 0)</beardMeshSize>
    <randomChosen>false</randomChosen>
  </HeadTypeDef>

</Defs>

<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- FCP Animals 1.6 references three desiccated textures which are not shipped by the mod. -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef/lifeStages/li/dessicatedBodyGraphicData/texPath[text()="Animals/Rad_Raven/FCP_Dessicated_Rad_Raven"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/PawnKindDef/lifeStages/li/dessicatedBodyGraphicData/texPath[text()="Animals/Rad_Raven/FCP_Dessicated_Rad_Raven"]</xpath>
      <value>
        <texPath>Things/Pawn/Animal/Chicken/Dessicated_Chicken</texPath>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef/lifeStages/li/dessicatedBodyGraphicData/texPath[text()="Animals/Radgull/FCP_Dessicated_Radgull"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/PawnKindDef/lifeStages/li/dessicatedBodyGraphicData/texPath[text()="Animals/Radgull/FCP_Dessicated_Radgull"]</xpath>
      <value>
        <texPath>Things/Pawn/Animal/Chicken/Dessicated_Chicken</texPath>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef/lifeStages/li/dessicatedBodyGraphicData/texPath[text()="Animals/Rad_Rabbit/Dessicated_FCP_RadRabbit"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/PawnKindDef/lifeStages/li/dessicatedBodyGraphicData/texPath[text()="Animals/Rad_Rabbit/Dessicated_FCP_RadRabbit"]</xpath>
      <value>
        <texPath>Things/Pawn/Animal/Hare/Dessicated_Hare</texPath>
      </value>
    </match>
  </Operation>
</Patch>

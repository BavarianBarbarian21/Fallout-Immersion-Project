<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="Arktos_SnakeThingBase">
    <defName>Arktos_Copperhead</defName>
    <label>copperhead</label>
    <description>A stocky pit viper whose scales have taken on the color of oxidized copper and wasteland dust. It hunts from ambush, delivering enough venom in a single bite to cripple much larger prey.</description>
    <statBases>
      <MoveSpeed>3.3</MoveSpeed>
      <MarketValue>190</MarketValue>
    </statBases>
    <comps>
      <li Class="CompProperties_EggLayer">
        <eggUnfertilizedDef>Arktos_EggCopperheadUnfertilized</eggUnfertilizedDef>
        <eggFertilizedDef>Arktos_EggCopperheadFertilized</eggFertilizedDef>
        <eggFertilizationCountMax>1</eggFertilizationCountMax>
        <eggLayIntervalDays>10</eggLayIntervalDays>
        <eggProgressUnfertilizedMax>0.5</eggProgressUnfertilizedMax>
        <eggCountRange>1~2</eggCountRange>
      </li>
    </comps>
    <race>
      <meatLabel>copperhead meat</meatLabel>
      <manhunterOnTameFailChance>0.35</manhunterOnTameFailChance>
    </race>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">

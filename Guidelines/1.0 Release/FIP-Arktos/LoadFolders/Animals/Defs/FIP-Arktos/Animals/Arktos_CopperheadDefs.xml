    <label>copperhead</label>
    <race>Arktos_Copperhead</race>
    <combatPower>80</combatPower>
    <ecoSystemWeight>0.25</ecoSystemWeight>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>FIP-Arktos/Animals/Snakes/Copperhead/Arktos_Copperhead_v7</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1</drawSize>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Cobra/Dessicated_Cobra</texPath>
          <drawSize>1</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>FIP-Arktos/Animals/Snakes/Copperhead/Arktos_Copperhead_v7</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.25</drawSize>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Cobra/Dessicated_Cobra</texPath>
          <drawSize>1.25</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>FIP-Arktos/Animals/Snakes/Copperhead/Arktos_Copperhead_v7</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.5</drawSize>
        </bodyGraphicData>

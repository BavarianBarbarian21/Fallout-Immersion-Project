  <ThingDef ParentName="EggFertBase">
    <defName>Arktos_EggCopperheadFertilized</defName>
    <label>copperhead egg (fert.)</label>
    <description>A fertilized copperhead egg. If kept warm, it will hatch into a copperhead.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AnimalProductRaw/EggOval</texPath>
      <color>(173,124,87)</color>
    </graphicData>
    <statBases>
      <MarketValue>28</MarketValue>
    </statBases>
    <comps>
      <li Class="CompProperties_Hatcher">
        <hatcherDaystoHatch>4.5</hatcherDaystoHatch>
        <hatcherPawn>Arktos_Copperhead</hatcherPawn>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="EggUnfertBase">
    <defName>Arktos_EggCopperheadUnfertilized</defName>
    <label>copperhead egg (unfert.)</label>
    <description>An unfertilized copperhead egg. It can be eaten raw, but is safer cooked.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AnimalProductRaw/EggOval</texPath>
      <color>(173,124,87)</color>
    </graphicData>
    <statBases>
      <MarketValue>18</MarketValue>
    </statBases>
  </ThingDef>

</Defs>

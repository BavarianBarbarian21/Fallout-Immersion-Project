<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Generated additive tags for Vanilla Quests Expanded - Ancients (vanillaquestsexpanded.ancients). -->
  <!-- Original source tags are preserved. Missing targets are skipped safely. -->

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/*[defName="VQEA_Apparel_PatientGown"]/apparel/tags</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/*[defName="VQEA_Apparel_PatientGown"]/apparel/tags</xpath>
      <value>
        <li>FIPA_Pool_VaultHighTech</li>
      </value>
    </match>
    <nomatch Class="PatchOperationConditional">
      <xpath>/Defs/*[defName="VQEA_Apparel_PatientGown"]/apparel</xpath>
      <match Class="PatchOperationAdd">
        <xpath>/Defs/*[defName="VQEA_Apparel_PatientGown"]/apparel</xpath>
        <value>
          <tags>
            <li>FIPA_Pool_VaultHighTech</li>
          </tags>
        </value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/*[defName="VQEA_Apparel_PatientGown"]</xpath>
        <value>
          <apparel>
            <tags>
              <li>FIPA_Pool_VaultHighTech</li>
            </tags>
          </apparel>
        </value>
      </nomatch>
    </nomatch>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/*[defName="VQEA_MeleeWeapon_Scalpel"]/weaponTags</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/*[defName="VQEA_MeleeWeapon_Scalpel"]/weaponTags</xpath>
      <value>
          <li>FIPW_Pool_Caravan</li>
          <li>FIPW_Pool_Ghoul</li>
          <li>FIPW_Pool_Raider</li>
          <li>FIPW_Pool_Settler</li>
          <li>FIPW_Pool_SlaveLowTech</li>
          <li>FIPW_Pool_Wastelander</li>
          <li>FIPW_Role_Melee</li>
          <li>FIPW_T0_Improvised</li>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/*[defName="VQEA_MeleeWeapon_Scalpel"]</xpath>
      <value>
        <weaponTags>
          <li>FIPW_Pool_Caravan</li>
          <li>FIPW_Pool_Ghoul</li>
          <li>FIPW_Pool_Raider</li>
          <li>FIPW_Pool_Settler</li>
          <li>FIPW_Pool_SlaveLowTech</li>
          <li>FIPW_Pool_Wastelander</li>
          <li>FIPW_Role_Melee</li>
          <li>FIPW_T0_Improvised</li>
        </weaponTags>
      </value>
    </nomatch>
  </Operation>

</Patch>

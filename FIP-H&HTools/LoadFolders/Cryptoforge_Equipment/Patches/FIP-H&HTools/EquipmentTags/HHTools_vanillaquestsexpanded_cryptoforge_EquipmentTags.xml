      <xpath>/Defs/*[defName="VQE_Apparel_CryptoHeavyHelmet"]/apparel/tags</xpath>
      <value>
        <li>FIPA_Pool_CircleOfSteel</li>
        <li>FIPA_Pool_VaultHighTech</li>
      </value>
    </match>

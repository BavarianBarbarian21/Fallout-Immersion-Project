<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--American Male-->
  <RulePackDef>
    <defName>HHTools_PawnNameMaker_American_Male</defName>
    <rulePack>
      <rulesStrings>
        <li>r_name-&gt;[firstName] [lastName]</li>
        <li>firstName(p=10)-&gt;[firstNameA]</li>
        <li>lastName(p=10)-&gt;[lastNameA]</li>
        <li>firstName-&gt;[firstNameB]</li>
        <li>lastName-&gt;[lastNameB]</li>
      </rulesStrings>
      <rulesFiles>
        <li>firstNameA-&gt;Names/HHTools_Names_American_Male</li>
        <li>lastNameA-&gt;Names/HHTools_Names_American_Last</li>
        <li>firstNameB-&gt;Names/HHTools_Names_Chinese_Male</li>
        <li>lastNameB-&gt;Names/HHTools_Names_Chinese_Last</li>
      </rulesFiles>
    </rulePack>
  </RulePackDef>
  <!--American
    Female-->
  <RulePackDef>
    <defName>HHTools_PawnNameMaker_American_Female</defName>
    <rulePack>
      <rulesStrings>
        <li>r_name-&gt;[firstName] [lastName]</li>
        <li>firstName(p=10)-&gt;[firstNameA]</li>
        <li>lastName(p=10)-&gt;[lastNameA]</li>
        <li>firstName-&gt;[firstNameB]</li>
        <li>lastName-&gt;[lastNameB]</li>
      </rulesStrings>
      <rulesFiles>
        <li>firstNameA-&gt;Names/HHTools_Names_American_Female</li>
        <li>lastNameA-&gt;Names/HHTools_Names_American_Last</li>
        <li>firstNameB-&gt;Names/HHTools_Names_Chinese_Female</li>
        <li>lastNameB-&gt;Names/HHTools_Names_Chinese_Last</li>
      </rulesFiles>
    </rulePack>
  </RulePackDef>
  <!--Raider
    Male-->
  <RulePackDef>
    <defName>HHTools_PawnNameMaker_Raider_Male</defName>
    <include>
      <li>HHTools_PawnNameMaker_American_Male</li>
    </include>
    <rulePack>
      <rulesStrings>
        <li>r_name-&gt;[firstName] '[nickNameName]' [lastName]</li>
      </rulesStrings>
      <rulesFiles>
        <li>nickName-&gt;Names/HHTools_Names_Raider_Male</li>
      </rulesFiles>
    </rulePack>
  </RulePackDef>
  <!--Raider
    Female-->
  <RulePackDef>
    <defName>HHTools_PawnNameMaker_Raider_Female</defName>
    <include>
      <li>HHTools_PawnNameMaker_American_Female</li>
    </include>
    <rulePack>
      <rulesStrings>
        <li>r_name-&gt;[firstName] '[nickNameName]' [lastName]</li>
      </rulesStrings>
      <rulesFiles>
        <li>nickName-&gt;Names/HHTools_Names_Raider_Female</li>
      </rulesFiles>
    </rulePack>
  </RulePackDef>
  <!--Mutant
    Male-->
  <!--Mutant
    Female-->
  <!--Ghoul
    Male-->
  <!--Ghoul
    Female-->
  <!--Numen
    Male-->
  <!--Numen

      <xpath>/Defs/*[defName="VFET_Apparel_TribalHeavy"]/apparel/tags</xpath>
      <value>
        <li>FIPA_Pool_Numen</li>
        <li>FIPA_Pool_Slanter</li>
        <li>FIPA_Pool_Tribal</li>
      </value>
    </match>
    <nomatch Class="PatchOperationConditional">
      <xpath>/Defs/*[defName="VFET_Apparel_TribalHeavy"]/apparel</xpath>
      <match Class="PatchOperationAdd">
        <xpath>/Defs/*[defName="VFET_Apparel_TribalHeavy"]/apparel</xpath>
        <value>
          <tags>
            <li>FIPA_Pool_Numen</li>
            <li>FIPA_Pool_Slanter</li>
            <li>FIPA_Pool_Tribal</li>
          </tags>
        </value>

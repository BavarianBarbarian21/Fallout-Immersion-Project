<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Keep the vanilla Horse pawn while replacing its artwork with one complete Arktos set. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/PawnKindDef[defName="Horse"]/lifeStages/li/bodyGraphicData/texPath</xpath>
    <value>
      <texPath>FIP-Arktos/Animals/Horse/Arktos_Horse</texPath>
    </value>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/PawnKindDef[defName="Horse"]/lifeStages/li/bodyGraphicData/graphicClass</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/PawnKindDef[defName="Horse"]/lifeStages/li/bodyGraphicData/graphicClass</xpath>
      <value>
        <graphicClass>Graphic_Multi</graphicClass>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/PawnKindDef[defName="Horse"]/lifeStages/li/bodyGraphicData</xpath>
      <value>
        <graphicClass>Graphic_Multi</graphicClass>
      </value>
    </nomatch>
  </Operation>

  <!-- Recolor the custom white Arktos artwork without introducing extra coat textures. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/PawnKindDef[defName="Horse"]/alternateGraphicChance</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/PawnKindDef[defName="Horse"]/alternateGraphicChance</xpath>
      <value>
        <alternateGraphicChance>1</alternateGraphicChance>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/PawnKindDef[defName="Horse"]</xpath>
      <value>
        <alternateGraphicChance>1</alternateGraphicChance>
      </value>
    </nomatch>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/PawnKindDef[defName="Horse"]/alternateGraphics</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/PawnKindDef[defName="Horse"]/alternateGraphics</xpath>
      <value>
        <alternateGraphics>
          <li><weight>1</weight><color>(1,1,1,1)</color></li>
          <li><weight>2</weight><color>(0.22,0.20,0.18,1)</color></li>
          <li><weight>4</weight><color>(0.38,0.22,0.12,1)</color></li>
          <li><weight>4</weight><color>(0.58,0.31,0.16,1)</color></li>
          <li><weight>3</weight><color>(0.72,0.56,0.34,1)</color></li>
          <li><weight>2</weight><color>(0.55,0.56,0.56,1)</color></li>
        </alternateGraphics>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/PawnKindDef[defName="Horse"]</xpath>
      <value>
        <alternateGraphics>
          <li><weight>1</weight><color>(1,1,1,1)</color></li>
          <li><weight>2</weight><color>(0.22,0.20,0.18,1)</color></li>
          <li><weight>4</weight><color>(0.38,0.22,0.12,1)</color></li>
          <li><weight>4</weight><color>(0.58,0.31,0.16,1)</color></li>
          <li><weight>3</weight><color>(0.72,0.56,0.34,1)</color></li>
          <li><weight>2</weight><color>(0.55,0.56,0.56,1)</color></li>
        </alternateGraphics>
      </value>
    </nomatch>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/PawnKindDef[defName="Horse"]/lifeStages/li/dessicatedBodyGraphicData/texPath</xpath>
    <value>
      <texPath>FIP-Arktos/Animals/Horse/Arktos_Horse_skeleton</texPath>
    </value>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/PawnKindDef[defName="Horse"]/lifeStages/li/dessicatedBodyGraphicData/graphicClass</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/PawnKindDef[defName="Horse"]/lifeStages/li/dessicatedBodyGraphicData/graphicClass</xpath>
      <value>
        <graphicClass>Graphic_Single</graphicClass>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/PawnKindDef[defName="Horse"]/lifeStages/li/dessicatedBodyGraphicData</xpath>
      <value>
        <graphicClass>Graphic_Single</graphicClass>
      </value>
    </nomatch>
  </Operation>

</Patch>

  <ThingDef ParentName="Arktos_SnakeThingBase">
    <defName>Arktos_CoralSnake</defName>
    <label>coral snake</label>
    <description>A slender wasteland serpent marked by vivid bands that survived every mutation the old world could inflict. Coral snakes avoid open ground, but their compact fangs deliver a fast-acting neurotoxin when cornered.</description>
    <comps>
      <li Class="CompProperties_EggLayer">
        <eggUnfertilizedDef>Arktos_EggCoralSnakeUnfertilized</eggUnfertilizedDef>
        <eggFertilizedDef>Arktos_EggCoralSnakeFertilized</eggFertilizedDef>
        <eggFertilizationCountMax>1</eggFertilizationCountMax>
        <eggLayIntervalDays>10</eggLayIntervalDays>
        <eggProgressUnfertilizedMax>0.5</eggProgressUnfertilizedMax>
        <eggCountRange>1~2</eggCountRange>
      </li>
    </comps>
    <race>
      <meatLabel>coral snake meat</meatLabel>
    </race>
  </ThingDef>


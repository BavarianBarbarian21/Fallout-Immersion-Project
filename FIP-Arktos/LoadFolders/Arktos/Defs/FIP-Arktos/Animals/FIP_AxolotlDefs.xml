<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>FIP_Axolotl</defName>
    <label>axolotl</label>
    <description>A small freshwater salamander whose exposed gills and regenerative body let it survive in Arktos' creeks, flooded ruins, and irradiated wetlands. Axolotls are harmless scavenging critters, prized more for their striking colors than for meat or leather.</description>
    <statBases>
      <MoveSpeed>3.8</MoveSpeed>
      <MarketValue>40</MarketValue>
      <ComfyTemperatureMin>0</ComfyTemperatureMin>
      <ComfyTemperatureMax>32</ComfyTemperatureMax>
      <ToxicEnvironmentResistance>0.6</ToxicEnvironmentResistance>
      <Wildness>0.5</Wildness>
    </statBases>
    <uiIconScale>1.6</uiIconScale>
    <tools>
      <li>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>4</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>2</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <race>
      <body>QuadrupedAnimalWithPawsAndTail</body>

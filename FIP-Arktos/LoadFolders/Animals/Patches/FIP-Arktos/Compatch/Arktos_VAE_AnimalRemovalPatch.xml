      <li Class="PatchOperationRemove"><success>Always</success><xpath>Defs/ThingDef[contains("|AEXP_EggCrocodileUnfertilized|AEXP_EggCrocodileFertilized|AEXP_EggPlatypusUnfertilized|AEXP_EggPlatypusFertilized|", concat("|", defName, "|"))]/tradeability</xpath></li>

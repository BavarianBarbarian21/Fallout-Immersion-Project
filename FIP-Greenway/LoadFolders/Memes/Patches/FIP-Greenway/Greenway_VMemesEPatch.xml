    <xpath>/Defs/IdeoPresetDef[defName="VME_Human_Hive"]/memes</xpath>
    <value><memes><li>VME_Gestalt</li><li>Greenway_MutantMasters</li><li>Collectivist</li></memes></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/IdeoPresetDef[defName="VME_Egalitarian_Republic"]/memes</xpath>
    <value><memes><li>Greenway_Government_Democratic</li><li>VME_Republic</li><li>VME_Egalitarian</li></memes></value>
  </Operation>

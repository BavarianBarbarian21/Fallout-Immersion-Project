  <!-- Royalty integration is optional in VMemesE. Translatable text lives in
       the conditionally loaded VMemesE_Royalty language layer. -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/MemeDef[defName="VME_Royal"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/MemeDef[defName="VME_Royal"]/exclusionTags</xpath>
      <value><li>FIP_DemocraticVsAutocracy</li></value>
    </match>
  </Operation>

</Patch>

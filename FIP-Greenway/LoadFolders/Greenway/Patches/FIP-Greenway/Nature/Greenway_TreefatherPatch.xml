<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Treefather graphics. All visible text is supplied by DefInjected. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Plant_TreeGauranlen"]/graphicData</xpath>
    <value>
      <graphicData>
        <texPath>FIP-Greenway/Tree/Treefather/Greenway_TreefatherB</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <shadowData><volume>(0.21, 0.6, 0.21)</volume></shadowData>
      </graphicData>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Plant_TreeGauranlen"]/plant/immatureGraphicPath</xpath>
    <value><immatureGraphicPath>FIP-Greenway/Tree/Treefather/Greenway_TreefatherB</immatureGraphicPath></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Plant_TreeGauranlen"]/plant/snowOverlayGraphicPath</xpath>
    <value><snowOverlayGraphicPath>FIP-Greenway/Tree/Treefather/Greenway_TreefatherB</snowOverlayGraphicPath></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Plant_TreeGauranlen"]/plant/immatureSnowOverlayGraphicPath</xpath>
    <value><immatureSnowOverlayGraphicPath>FIP-Greenway/Tree/Treefather/Greenway_TreefatherB</immatureSnowOverlayGraphicPath></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="ChoppedStump_Gauranlen"]/graphicData/texPath</xpath>
    <value><texPath>FIP-Greenway/Tree/Treefather/Greenway_TreefatherC</texPath></value>
  </Operation>
</Patch>

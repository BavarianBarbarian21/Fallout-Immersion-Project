<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="RobCo_BaseGun">
		<defName>RobCo_SecuritronLaser</defName>
		<label>securitron ballistic repeater</label>
		<description>Integrated ballistic repeater mounted on a Securitron Mark I security platform.</description>
		<graphicData>
			<texPath>FIP-RobCo/Weapons/Securitron/RobCo_SecuritronArm</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<weaponTags>
			<li>RobCo_SecuritronLaser</li>
		</weaponTags>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<defaultProjectile>RobCo_Bullet_BallisticAuto</defaultProjectile>
				<warmupTime>0.9</warmupTime>
				<range>28</range>
				<burstShotCount>5</burstShotCount>
				<ticksBetweenBurstShots>5</ticksBetweenBurstShots>
				<soundCast>Shot_MachinePistol</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>1.5</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>shock baton</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>1.9</cooldownTime>
			</li>
		</tools>
	</ThingDef>

	<ThingDef ParentName="RobCo_BaseGun">
		<defName>RobCo_SecuritronElectroshock</defName>
		<label>securitron 9mm submachine gun</label>
		<description>An upgraded 9mm submachine gun integrated into a Securitron Mark II with an onboard rocket battery.</description>
		<statBases>
			<AccuracyTouch>0.85</AccuracyTouch>
			<AccuracyShort>0.78</AccuracyShort>
			<AccuracyMedium>0.65</AccuracyMedium>
			<AccuracyLong>0.45</AccuracyLong>
			<RangedWeapon_Cooldown>0.9</RangedWeapon_Cooldown>
		</statBases>
		<graphicData>
			<texPath>FIP-RobCo/Weapons/Securitron/RobCo_SecuritronArm</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<weaponTags>
			<li>RobCo_SecuritronElectroshock</li>
		</weaponTags>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<defaultProjectile>RobCo_Bullet_BallisticAuto</defaultProjectile>
				<warmupTime>0.7</warmupTime>
				<range>30</range>
				<burstShotCount>8</burstShotCount>
				<ticksBetweenBurstShots>4</ticksBetweenBurstShots>
				<soundCast>Shot_MachinePistol</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>1.7</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>high-voltage baton</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>12</power>
				<cooldownTime>1.8</cooldownTime>
			</li>
		</tools>
	</ThingDef>
</Defs>

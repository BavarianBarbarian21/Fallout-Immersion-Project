		<displayPriority>600</displayPriority>
	</RecipeDef>
	<!--  Liberty Prime   -->
	<ThingDef ParentName="RobCo_LibertyPrimeBase">
		<defName>RobCo_LibertyPrime</defName>
		<label>Liberty Prime</label>
		<description>A massive pre-War war machine jointly developed by RobCo Industries and General Atomics International for the United States Army. It stands approximately twenty meters tall and is equipped with twin head-mounted energy cannons and a supply of tactical nuclear bombs for destroying fortified positions. Originally designed to liberate Anchorage from Chinese forces, it was never deployed before the Great War due to power supply failures.</description>
		<comps>
			<li Class="CompProperties_TargetingBeam" />
			<li Class="FIP.RobCo.CompProperties_DelayedDeathStrike">
				<delayTicks>180</delayTicks>
				<orbitalStrikeDef>PowerBeam</orbitalStrikeDef>
			</li>
			<li Class="FIP.RobCo.CompProperties_AbilityReloadable" />
		</comps>
	</ThingDef>
	<PawnKindDef ParentName="RobCo_HugeRobotKind">
		<defName>RobCo_LibertyPrime</defName>
		<label>Liberty Prime</label>
		<race>RobCo_LibertyPrime</race>
		<combatPower>1200</combatPower>
		<lifeStages>
			<li>
				<bodyGraphicData>
					<texPath>FIP-RobCo/Robots/LibertyPrime/LibertyPrimeMK1/RobCo_body</texPath>
					<shaderType>CutoutWithOverlay</shaderType>
					<graphicClass>Graphic_Multi</graphicClass>
					<drawSize>3.0</drawSize>
					<shadowData>
						<volume>(1.0, 1.0, 1.0)</volume>
						<offset>(0,0,-0.25)</offset>
					</shadowData>
				</bodyGraphicData>
			</li>
		</lifeStages>
		<weaponTags>
			<li>RobCo_LibertyPrimeMiniNukeLauncher</li>
		</weaponTags>
		<abilities>
			<li>RobCo_LibertyPrimeNukeThrow</li>
		</abilities>
	</PawnKindDef>
	<RecipeDef ParentName="RobCo_LibertyPrimeBase_Recipe">
		<defName>RobCo_RestoreLibertyPrime</defName>
		<label>restore Liberty Prime</label>
		<description>Restore the unique Liberty Prime chassis recovered from the RobCo vault. The platinum chip is integrated into its command system and consumed permanently.</description>
		<descriptionHyperlinks>
			<ThingDef>RobCo_LibertyPrime</ThingDef>
		</descriptionHyperlinks>
	</RecipeDef>
	<!--
		Save-compatibility shell for pre-quest-overhaul Bill_ProductionMech
		instances. It is intentionally not assigned to any building. Loaded saves
		cancel these obsolete bills and eject their ingredients before play resumes.
	-->
	<RecipeDef ParentName="BaseMechanoidRecipe">
		<defName>RobCo_LibertyPrime_Recipe</defName>
		<label>obsolete Liberty Prime production project</label>
		<description>Compatibility definition for an obsolete Liberty Prime production bill. Existing bills are cancelled and their ingredients returned when the save loads.</description>
		<gestationCycles>25</gestationCycles>
		<ingredients>
			<li>
				<filter><thingDefs><li>Steel</li></thingDefs></filter>
				<count>600</count>
			</li>
			<li>
				<filter><thingDefs><li>Plasteel</li></thingDefs></filter>
				<count>450</count>
			</li>
			<li>
				<filter><thingDefs><li>Uranium</li></thingDefs></filter>
				<count>100</count>
			</li>
			<li>
				<filter><thingDefs><li>NanostructuringChip</li></thingDefs></filter>
				<count>2</count>
			</li>
			<li>
				<filter><thingDefs><li>ComponentSpacer</li></thingDefs></filter>
				<count>6</count>
			</li>
			<li>
				<filter><thingDefs><li>RobCo_PlatinumChip</li></thingDefs></filter>
				<count>3</count>
			</li>
			<li>
				<filter><thingDefs><li>Corpse_RobCo_LibertyPrime</li></thingDefs></filter>
				<count>1</count>
			</li>
		</ingredients>
		<displayPriority>600</displayPriority>
		<products>
			<RobCo_LibertyPrime>1</RobCo_LibertyPrime>
		</products>
	</RecipeDef>
</Defs>

<Defs>
	<!--  Liberty Prime Base  -->
	<ThingDef Name="RobCo_LibertyPrimeBase" ParentName="BaseMechanoid" Abstract="True">
		<statBases>
			<MarketValue>8000</MarketValue>
			<MoveSpeed>2.0</MoveSpeed>
			<ControlTakingTime>60</ControlTakingTime>
			<BandwidthCost>10</BandwidthCost>
			<ArmorRating_Blunt>0.40</ArmorRating_Blunt>
			<ArmorRating_Sharp>0.75</ArmorRating_Sharp>
			<PsychicSensitivity>0.90</PsychicSensitivity>
			<MechEnergyLossPerHP>0.15</MechEnergyLossPerHP>
		</statBases>
		<race>
			<body>RobCo_Assaultron</body>
			<intelligence>ToolUser</intelligence>
			<thinkTreeMain>Mechanoid</thinkTreeMain>
			<soundCallIntervalRange>6000~12000</soundCallIntervalRange>
			<soundCallIntervalFriendlyFactor>2</soundCallIntervalFriendlyFactor>
			<baseBodySize>3.0</baseBodySize>
			<baseHealthScale>10.0</baseHealthScale>
			<mechWeightClass>Heavy</mechWeightClass>
			<lifeStageAges>
				<li>
					<def>MechanoidFullyFormed</def>
					<minAge>0</minAge>
					<soundWounded>RobCo_LibertyPrime_Wounded</soundWounded>
					<soundDeath>RobCo_LibertyPrime_Death</soundDeath>
					<soundCall>RobCo_LibertyPrime_Call</soundCall>
					<soundAngry>RobCo_LibertyPrime_Angry</soundAngry>
				</li>
			</lifeStageAges>
		</race>
		<butcherProducts>
			<Steel>75</Steel>
			<Plasteel>40</Plasteel>
			<Uranium>15</Uranium>
		</butcherProducts>
		<tools>
			<li>
				<label>fists</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>40</power>
				<cooldownTime>1.4</cooldownTime>
				<linkedBodyPartsGroup>Torso</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
			</li>
		</tools>
	</ThingDef>

<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Arktos Biomes -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/BiomeDef[@Name="Arktos_Nature"]/allowedPackAnimals/li[.="Horse"]</xpath>
    <match Class="PatchOperationRemove">
      <xpath>/Defs/BiomeDef[@Name="Arktos_Nature"]/allowedPackAnimals/li[.="Horse"]</xpath>
    </match>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/BiomeDef[@Name="Arktos_Nature"]/allowedPackAnimals</xpath>
    <value>
      <li>Horse</li>
    </value>
  </Operation>
</Patch>

<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Brahmin -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/FactionDef/pawnGroupMakers/li[kindDef="Trader"]/carriers/FCP_Animal_Brahmin</xpath>
    <match Class="PatchOperationRemove">
      <xpath>/Defs/FactionDef/pawnGroupMakers/li[kindDef="Trader"]/carriers/FCP_Animal_Brahmin</xpath>
    </match>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/FactionDef/pawnGroupMakers/li[kindDef="Trader"]/carriers</xpath>
    <value>
      <FCP_Animal_Brahmin>8</FCP_Animal_Brahmin>
    </value>
  </Operation>

  <!-- Biomes -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/BiomeDef[not(@ParentName) or allowedPackAnimals[@Inherit="False"]]/allowedPackAnimals/li[.="FCP_Animal_Brahmin"]</xpath>
    <match Class="PatchOperationRemove">
      <xpath>/Defs/BiomeDef[not(@ParentName) or allowedPackAnimals[@Inherit="False"]]/allowedPackAnimals/li[.="FCP_Animal_Brahmin"]</xpath>
    </match>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/BiomeDef[not(@ParentName) or allowedPackAnimals[@Inherit="False"]]/allowedPackAnimals</xpath>
    <value>
      <li>FCP_Animal_Brahmin</li>
    </value>
  </Operation>

</Patch>

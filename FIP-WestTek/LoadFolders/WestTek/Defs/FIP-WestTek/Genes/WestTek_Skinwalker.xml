<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <GeneDef>
    <defName>WestTek_Gene_SkinwalkerMutation</defName>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <label>skinwalker mutation</label>
    <description>This S'Lanter carries an unstable experimental fauna mutation, allowing controlled transformation into a Skinwalker form without changing their underlying xenotype.</description>
    <iconPath>UI/Icons/Genes/WestTek_SkinwalkerMutation</iconPath>
    <displayOrderInCategory>500</displayOrderInCategory>
    <biostatCpx>3</biostatCpx>
    <biostatMet>-2</biostatMet>
    <biostatArc>1</biostatArc>
    <abilities>
      <li>WestTek_Ability_SkinwalkerShift</li>
    </abilities>
  </GeneDef>

  <GeneDef>
    <defName>WestTek_Gene_SkinwalkerRaccoonShape</defName>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <label>skinwalker form</label>
    <description>The active Skinwalker form collapses a S'Lanter's silhouette toward its old raccoon ancestry. Returning to the standard form removes this temporary xenogene.</description>
    <iconPath>UI/Icons/Genes/WestTek_SkinwalkerMutation</iconPath>
    <displayOrderInCategory>501</displayOrderInCategory>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-2</biostatMet>
    <exclusionTags>
      <li>WestTek_SLanterFormAppearance</li>
    </exclusionTags>
    <fur>WestTek_SkinwalkerRaccoon</fur>
    <forcedHeadTypes>
      <li>WestTek_Skinwalker_InvisibleHead</li>
    </forcedHeadTypes>
    <hairTagFilter>
      <whitelist>true</whitelist>
      <tags>
        <li>Bald</li>
      </tags>
    </hairTagFilter>
    <beardTagFilter>
      <whitelist>true</whitelist>
      <tags>
        <li>NoBeard</li>
      </tags>
    </beardTagFilter>
    <renderNodeProperties>
      <li>
        <debugLabel>Skinwalker raccoon body</debugLabel>
        <nodeClass>PawnRenderNode_Fur</nodeClass>
        <workerClass>PawnRenderNodeWorker_Fur</workerClass>
        <baseLayer>5</baseLayer>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <colorType>Skin</colorType>
        <parentTagDef>Body</parentTagDef>
      </li>
    </renderNodeProperties>
    <statOffsets>
      <MoveSpeed>0.30</MoveSpeed>
      <MeleeDPS>0.25</MeleeDPS>
    </statOffsets>
  </GeneDef>

  <AbilityDef>
    <defName>WestTek_Ability_SkinwalkerShift</defName>
    <label>skinwalker shift</label>
    <description>Temporarily assume an unstable Skinwalker form, or return to the standard S'Lanter form.</description>
    <iconPath>UI/Icons/Genes/WestTek_SkinwalkerMutation</iconPath>
    <targetRequired>false</targetRequired>
    <cooldownTicksRange>60000~60000</cooldownTicksRange>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <drawAimPie>false</drawAimPie>
      <requireLineOfSight>false</requireLineOfSight>
      <nonInterruptingSelfCast>true</nonInterruptingSelfCast>
      <warmupTime>1</warmupTime>
      <range>0</range>
      <targetable>false</targetable>
      <targetParams>
        <canTargetSelf>True</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="FIP.WestTek.CompProperties_AbilitySkinwalkerShift" />
    </comps>
  </AbilityDef>

</Defs>

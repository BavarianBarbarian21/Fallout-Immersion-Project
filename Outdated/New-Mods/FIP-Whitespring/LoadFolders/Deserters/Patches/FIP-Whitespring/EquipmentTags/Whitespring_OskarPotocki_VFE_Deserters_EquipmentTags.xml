      <xpath>/Defs/*[defName="VFED_Gun_ChargeCycler"]/weaponTags</xpath>
      <value>
          <li>FIPW_Pool_CircleOfSteel</li>
          <li>FIPW_Pool_Enclave</li>
          <li>FIPW_Pool_VaultHighTech</li>
          <li>FIPW_Role_Laser</li>
          <li>FIPW_T4_Elite</li>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/*[defName="VFED_Gun_ChargeCycler"]</xpath>
      <value>
        <weaponTags>
          <li>FIPW_Pool_CircleOfSteel</li>
          <li>FIPW_Pool_Enclave</li>
          <li>FIPW_Pool_VaultHighTech</li>
          <li>FIPW_Role_Laser</li>
          <li>FIPW_T4_Elite</li>

<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Generated additive tags for Vanilla Factions Expanded - Deserters (OskarPotocki.VFE.Deserters). -->
  <!-- Original source tags are preserved. Missing targets are skipped safely. -->

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/*[defName="VFED_Apparel_BombPack"]/apparel/tags</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/*[defName="VFED_Apparel_BombPack"]/apparel/tags</xpath>
      <value>
        <li>FIPA_Pool_CircleOfSteel</li>
      </value>
    </match>
    <nomatch Class="PatchOperationConditional">
      <xpath>/Defs/*[defName="VFED_Apparel_BombPack"]/apparel</xpath>
      <match Class="PatchOperationAdd">
        <xpath>/Defs/*[defName="VFED_Apparel_BombPack"]/apparel</xpath>
        <value>
          <tags>
            <li>FIPA_Pool_CircleOfSteel</li>
          </tags>
        </value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/*[defName="VFED_Apparel_BombPack"]</xpath>
        <value>
          <apparel>
            <tags>
              <li>FIPA_Pool_CircleOfSteel</li>
            </tags>
          </apparel>
        </value>
      </nomatch>
    </nomatch>
  </Operation>

